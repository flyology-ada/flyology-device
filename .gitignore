*.ali
*.o
*.a
*.dSYM/

#  GNAT's binder writes b~<main>.ads and b~<main>.adb next to the objects it
#  is binding. They are generated Ada source, so nothing that filters by
#  extension or by "is it text" will catch them; they have to be named.
b~*.ads
b~*.adb

#  gnatmake writes an executable into the current directory unless it is
#  told otherwise, so a build run from the repository root leaves the test
#  and showcase programs here. They belong in each crate's bin/, which is
#  ignored above; these entries stop a stray root-level build from being
#  committed.
/scalar_tests
/address_space_tests
/region_tests
/mapper_tests
/pool_tests
/host_readiness
/region_walkthrough
