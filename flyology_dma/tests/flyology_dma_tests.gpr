with "../flyology_dma.gpr";

project Flyology_DMA_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("scalar_tests.adb", "region_tests.adb", "mapper_tests.adb",
      "address_space_tests.adb", "pool_tests.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;
end Flyology_DMA_Tests;
