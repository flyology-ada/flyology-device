with "../flyology_vfio_qemu.gpr";

project Flyology_VFIO_QEMU_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("edu_tests.adb", "container_sharing_tests.adb",
      "pci_testdev_tests.adb", "nvme_tests.adb", "e1000e_tests.adb",
      "nvme_coverage_tests.adb", "e1000e_coverage_tests.adb", "msix_tests.adb", "nvme_queues_tests.adb", "nvme_zoned_tests.adb", "nvme_copy_tests.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;
end Flyology_VFIO_QEMU_Tests;
