with "../flyology_vfio/flyology_vfio.gpr";

project Flyology_VFIO_QEMU is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "flyology_vfio_qemu";
   for Library_Dir use "lib";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  Always checked. This crate exists to find out whether the layers
      --  below it are right, and a bring-up harness with its contracts
      --  compiled out would be testing something other than what ships.
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwJ", "-O1",
         "-fstack-check", "-fno-strict-aliasing");
   end Compiler;

   package Documentation is
      for Output_Dir ("html") use "docs/api";
   end Documentation;

end Flyology_VFIO_QEMU;
