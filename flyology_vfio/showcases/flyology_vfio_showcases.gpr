with "../flyology_vfio.gpr";

project Flyology_VFIO_Showcases is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("bring_up.adb", "host_readiness.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;
end Flyology_VFIO_Showcases;
